<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimationDuration">1</item>
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/app_background</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
    </style>
    <style name="Theme.App.Starting.Dark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimationDuration">1</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_dark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="android:windowBackground">@color/splash_bg_dark</item>
        <item name="android:statusBarColor">@color/splash_bg_dark</item>
        <item name="android:navigationBarColor">@color/splash_bg_dark</item>
    </style>
    <style name="Theme.App.Starting.Light" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimationDuration">1</item>
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg_light</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="android:windowBackground">@color/splash_bg_light</item>
        <item name="android:statusBarColor">@color/splash_bg_light</item>
        <item name="android:navigationBarColor">@color/splash_bg_light</item>
    </style>
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/app_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>

    </style>

</resources>